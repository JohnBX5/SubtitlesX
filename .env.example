# ==============================================================================
# Cinema Hub Subtitle Backend - Environment Configuration
# Copy this file to .env and configure with your credentials.
# NEVER commit .env to version control.
# ==============================================================================

# OpenSubtitles REST API Credentials
# Register your application at: https://www.opensubtitles.com/en/consumers
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# OpenSubtitles API Configuration
OPENSUBTITLES_BASE_URL=https://api.opensubtitles.com/api/v1
OPENSUBTITLES_USER_AGENT=CinemaHubSubtitleBackend v1.1.0

# Application Metadata
APP_NAME=CinemaHubSubtitleBackend
APP_VERSION=1.1.0
HOST=0.0.0.0
PORT=8000

# Database Configuration (SQLite via aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./subtitles.db

# Subtitle Cache Configuration
CACHE_DIR=cache
CACHE_TTL_HOURS=168

# Network, Concurrency & Security Limits
HTTP_TIMEOUT_SECONDS=20
MAX_SUBTITLE_FILE_SIZE_MB=10
MAX_SUBTITLE_CUE_COUNT=50000
MAX_CONCURRENT_REQUESTS=5

# Subtitle Audio Synchronization Limits
MAX_CONCURRENT_SYNC_JOBS=2
MAX_AUDIO_EXTRACT_SECONDS=900
MAX_AUDIO_EXTRACT_SIZE_MB=50
FFMPEG_TIMEOUT_SECONDS=45
FFMPEG_PATH=

# CORS Allowed Origins (Comma-separated list or * for all)
CORS_ORIGINS=*
